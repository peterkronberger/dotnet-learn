<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Playground</AssemblyName>
    <RootNamespace>Playground</RootNamespace>

    <!-- Roslyn uses reflection; trimming would cut the compiler and the framework
         assemblies that the user code needs later. -->
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <!-- GitHub Pages does not serve Brotli natively; the files are sent
         by the server with gzip instead. -->
    <BlazorEnableCompression>false</BlazorEnableCompression>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Exception messages in plain text instead of resource keys (e.g. "Arg_IndexOutOfRangeException"). -->
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.*" PrivateAssets="all" />
    <!-- Pre-release from the dotnet-tools feed (see nuget.config): the first Roslyn version that
         knows C# 15. Switch to the stable nuget.org package when it exists. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0-1.26430.105" />
    <!-- Fixed package set for user code (S6). Blazor ships the runtime DLLs anyway;
         the references for the compiler are embedded below. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.*" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.*" />
  </ItemGroup>

  <!--
    Reference assemblies for the Roslyn compiler.
    The user code is compiled against the reference assemblies of the .NET SDK (metadata only,
    a few hundred KB) and then runs on the runtime that Blazor loads anyway.
    The DLLs are embedded as resources in Playground.dll and read on first start.
  -->
  <Target Name="EmbedReferenceAssemblies" BeforeTargets="AssignTargetPaths">
    <!-- Take the directory from the resolved reference pack of $(TargetFramework). The SDK's
         BundledNETCoreAppPackageVersion can point to a newer major version than the target
         framework (e.g. 12.0.0 when a newer SDK is installed), whose pack does not contain net11.0. -->
    <ItemGroup>
      <SystemRuntimeRef Include="@(ReferencePath)" Condition="'%(Filename)' == 'System.Runtime'" />
    </ItemGroup>
    <PropertyGroup>
      <RefPackDir>@(SystemRuntimeRef->'%(RootDir)%(Directory)')</RefPackDir>
    </PropertyGroup>

    <ItemGroup>
      <ReferenceName Include="System.Runtime" />
      <ReferenceName Include="System.Runtime.Extensions" />
      <ReferenceName Include="System.Runtime.Numerics" />
      <ReferenceName Include="System.Console" />
      <ReferenceName Include="System.Collections" />
      <ReferenceName Include="System.Collections.Concurrent" />
      <ReferenceName Include="System.Linq" />
      <ReferenceName Include="System.Linq.AsyncEnumerable" />
      <ReferenceName Include="System.Memory" />
      <ReferenceName Include="System.IO" />
      <ReferenceName Include="System.Globalization" />
      <ReferenceName Include="System.Text.Encoding.Extensions" />
      <ReferenceName Include="System.Text.RegularExpressions" />
      <ReferenceName Include="System.Text.Json" />
      <ReferenceName Include="System.Threading" />
      <ReferenceName Include="System.Threading.Tasks" />
    </ItemGroup>

    <!-- Packages (not part of Microsoft.NETCore.App.Ref): the resolved assemblies of the fixed set. -->
    <ItemGroup>
      <ExtensionName Include="Microsoft.Extensions.DependencyInjection;Microsoft.Extensions.DependencyInjection.Abstractions;Microsoft.Extensions.Logging;Microsoft.Extensions.Logging.Abstractions;Microsoft.Extensions.Options" />
      <ExtensionRef Include="@(ReferencePath)" Condition="'%(Filename)' == 'Microsoft.Extensions.DependencyInjection'" />
      <ExtensionRef Include="@(ReferencePath)" Condition="'%(Filename)' == 'Microsoft.Extensions.DependencyInjection.Abstractions'" />
      <ExtensionRef Include="@(ReferencePath)" Condition="'%(Filename)' == 'Microsoft.Extensions.Logging'" />
      <ExtensionRef Include="@(ReferencePath)" Condition="'%(Filename)' == 'Microsoft.Extensions.Logging.Abstractions'" />
      <ExtensionRef Include="@(ReferencePath)" Condition="'%(Filename)' == 'Microsoft.Extensions.Options'" />
    </ItemGroup>

    <Error Condition="!Exists('$(RefPackDir)System.Runtime.dll')"
           Text="Reference assemblies not found at '$(RefPackDir)'. Check that the .NET SDK for $(TargetFramework) is installed." />

    <ItemGroup>
      <EmbeddedResource Include="$(RefPackDir)%(ReferenceName.Identity).dll"
                        LogicalName="refs/%(ReferenceName.Identity).dll"
                        Condition="Exists('$(RefPackDir)%(ReferenceName.Identity).dll')" />
      <EmbeddedResource Include="@(ExtensionRef)"
                        LogicalName="refs/%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

</Project>
