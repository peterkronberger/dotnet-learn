<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NETSDK1188</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.*" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="11.0.*" />
    <!-- Only the dotnet ef tool needs this package, so it stays out of the output -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SecLog.Core/SecLog.Core.csproj" />
    <ProjectReference Include="../SecLog.Data/SecLog.Data.csproj" />
  </ItemGroup>

</Project>
