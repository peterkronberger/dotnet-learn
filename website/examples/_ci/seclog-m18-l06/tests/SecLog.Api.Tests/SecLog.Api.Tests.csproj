<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <!-- xUnit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.*" />
    <!-- Starts the whole app in memory: WebApplicationFactory. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SecLog.Api/SecLog.Api.csproj" />
  </ItemGroup>

</Project>
